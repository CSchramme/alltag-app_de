# Vorlage für die öffentliche Version (alltag-app.de) – kopieren nach .env und ausfüllen.
# .env enthält Geheimnisse und kommt nie ins Git. In Plesk kannst du dieselben Werte als Umgebungsvariablen eintragen
# oder die fertige .env-Datei in den App-Ordner hochladen (neben app.js, nicht in public/).

# Konten (über den Konto-Dienst), eigener Look, ohne Home Assistant und PC-Fernsteuerung
ACCOUNTS=1

# Eigener Datenordner: beim Umzug auf den Server einfach mitkopieren
DATA_DIR=data-public

# Konto-Dienst (eigene App, eigenes Git: alltag-accounts): Registrieren, Anmelden, E-Mail, Passwort vergessen
ACCOUNTS_URL=https://accounts.alltag-app.de
# Gemeinsamer Schlüssel, derselbe Wert wie beim Konto-Dienst. Mindestens 32 zufällige Zeichen.
ACCOUNTS_SECRET=

# Verschlüsselt Schul-Passwörter und -Sitzungen. Mindestens 32 zufällige Zeichen, einmal setzen, NIE ändern.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_KEY=

# Adresse, die auf den Flyern steht (z. B. https://alltag-app.de)
PUBLIC_URL=

# Impressum und Datenschutzerklärung (LEGAL_EMAIL steht auch auf den Flyern)
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_LOG_DAYS=

# Nur am PC: Port für http://localhost:3000 (auf Plesk weglassen, das setzt Passenger selbst)
PORT=3000
